{
  "name": "loveplans",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export -p web && workbox generateSW workbox-config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "smoke": "node tools/smoke.mjs",
    "icons": "powershell -ExecutionPolicy Bypass -File tools/generate-icons.ps1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "puppeteer-core": "^25.18.1",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1"
  }
}
